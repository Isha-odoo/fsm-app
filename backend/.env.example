# Copy to .env and adjust.
PORT=4000
DATABASE_URL=postgres://fsm:fsm_dev_password@localhost:5432/fsm
# true for Supabase / any managed Postgres that requires TLS (leave false for local Docker)
DATABASE_SSL=false
# At least 32 characters. Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-to-a-long-random-string-of-32-chars-or-more
# Browser origin(s) allowed to call the API (comma separated)
# For an Android/iOS app (Capacitor) also add: https://localhost,capacitor://localhost
CORS_ORIGIN=http://localhost:3000
# Base URL used when building customer share links
PUBLIC_URL=http://localhost:3000
# GST state code of the seller (24 = Gujarat); decides CGST+SGST vs IGST on invoices
SELLER_STATE_CODE=24
# Set to 1 when the API runs behind one reverse proxy (nginx, Render, Railway...), so rate limits use the client IP
TRUST_PROXY=0
# Printed on quotations and invoices
COMPANY_NAME=Bhawani Print & Pack
COMPANY_ADDRESS=Your address line, Gandhinagar, Gujarat
COMPANY_GSTIN=
COMPANY_PHONE=
COMPANY_EMAIL=
